#!/usr/bin/env zsh
# vim: ft=zsh

# Trouver le kit même lorsqu'il est chargé depuis un autre répertoire.
local script=${(%):-%N}
local mydir=${${script:A}:h}

# Respecter l'ordre du kit ; les exports communs sont déjà chargés par
# .zshenv et .zprofile. Les rejouer ici modifierait inutilement l'environnement.
local f
for f in "$mydir"/??_*.zsh(Non.); do
  case ${f:t} in
    01_lang.zsh|01_path.zsh) continue ;;
  esac
  source -- "$f"
done
